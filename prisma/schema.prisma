// Esquema — módulo de gestión de pagos
// Documentación: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
}

enum EstadoContenedor {
  ACTIVO
  COMPLETADO
  FACTURADO
}

model Usuario {
  id           String   @id @default(cuid())
  usuario      String   @unique
  passwordHash String
  nombre       String?
  rol          Rol      @default(ADMIN)
  creadoEn     DateTime @default(now())

  cobradoresCreados      Cobrador[]      @relation("CobradorCreadoPor")
  cobradoresActualizados Cobrador[]      @relation("CobradorActualizadoPor")
  contenedoresCreados      Contenedor[]  @relation("ContenedorCreadoPor")
  contenedoresActualizados Contenedor[]  @relation("ContenedorActualizadoPor")
  pagosCreados      Pago[]              @relation("PagoCreadoPor")
  pagosActualizados Pago[]              @relation("PagoActualizadoPor")
  tiposCambioCreados      TipoCambioDia[] @relation("TipoCambioCreadoPor")
  tiposCambioActualizados TipoCambioDia[] @relation("TipoCambioActualizadoPor")
}

model Cobrador {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  pagos     Pago[]

  creadoEn        DateTime @default(now())
  creadoPorId     String?
  creadoPor       Usuario? @relation("CobradorCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoEn   DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor  Usuario? @relation("CobradorActualizadoPor", fields: [actualizadoPorId], references: [id])
}

model Contenedor {
  id                 String           @id @default(cuid())
  nombre             String
  codigo             String           @unique // ej. MSKU9395463
  saldoInicial       Decimal          @default(0) @db.Decimal(12, 2)
  monedaSaldoInicial String           @default("USD")
  fechaInicio        DateTime
  totalFactura       Decimal          @db.Decimal(12, 2)
  estado             EstadoContenedor @default(ACTIVO)
  pagos              Pago[]

  creadoEn        DateTime @default(now())
  creadoPorId     String?
  creadoPor       Usuario? @relation("ContenedorCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoEn   DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor  Usuario? @relation("ContenedorActualizadoPor", fields: [actualizadoPorId], references: [id])
}

model TipoCambioDia {
  fecha     DateTime @id @db.Date
  usdPorEur Decimal  @db.Decimal(10, 4)

  creadoEn        DateTime @default(now())
  creadoPorId     String?
  creadoPor       Usuario? @relation("TipoCambioCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoEn   DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor  Usuario? @relation("TipoCambioActualizadoPor", fields: [actualizadoPorId], references: [id])
}

model Pago {
  id           String      @id @default(cuid())
  contenedorId String?
  contenedor   Contenedor? @relation(fields: [contenedorId], references: [id])
  cobradorId   String?
  cobrador     Cobrador?   @relation(fields: [cobradorId], references: [id])
  fecha        DateTime    @db.Date
  persona      String
  importeEur   Decimal?    @db.Decimal(12, 2)
  importeUsd   Decimal?    @db.Decimal(12, 2)
  tasaCambio   Decimal?    @db.Decimal(10, 4)
  banco        String      @default("Revolut")
  idOrigen     String?     @unique // ID del movimiento en el banco, para no importar duplicados

  creadoEn        DateTime @default(now())
  creadoPorId     String?
  creadoPor       Usuario? @relation("PagoCreadoPor", fields: [creadoPorId], references: [id])
  actualizadoEn   DateTime @default(now()) @updatedAt
  actualizadoPorId String?
  actualizadoPor  Usuario? @relation("PagoActualizadoPor", fields: [actualizadoPorId], references: [id])
}
