// Esquema inicial — módulo de gestión de pagos
// Documentación: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
}

enum EstadoContenedor {
  ACTIVO
  COMPLETADO
  FACTURADO
}

model Usuario {
  id           String   @id @default(cuid())
  usuario      String   @unique
  passwordHash String
  nombre       String?
  rol          Rol      @default(ADMIN)
  createdAt    DateTime @default(now())
}

model Cobrador {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  pagos     Pago[]
}

model Contenedor {
  id                 String           @id @default(cuid())
  nombre             String
  codigo             String           @unique // ej. MSKU9395463
  saldoInicial       Decimal          @default(0) @db.Decimal(12, 2)
  monedaSaldoInicial String           @default("USD")
  fechaInicio        DateTime
  totalFactura       Decimal          @db.Decimal(12, 2)
  estado             EstadoContenedor @default(ACTIVO)
  createdAt          DateTime         @default(now())
  pagos              Pago[]
}

model TipoCambioDia {
  fecha     DateTime @id @db.Date
  usdPorEur Decimal  @db.Decimal(10, 4)
}

model Pago {
  id           String      @id @default(cuid())
  contenedorId String?
  contenedor   Contenedor? @relation(fields: [contenedorId], references: [id])
  cobradorId   String?
  cobrador     Cobrador?   @relation(fields: [cobradorId], references: [id])
  fecha        DateTime    @db.Date
  persona      String
  importeEur   Decimal?    @db.Decimal(12, 2)
  importeUsd   Decimal?    @db.Decimal(12, 2)
  tasaCambio   Decimal?    @db.Decimal(10, 4)
  banco        String      @default("Revolut")
  idOrigen     String?     @unique
  createdAt    DateTime    @default(now())
}
